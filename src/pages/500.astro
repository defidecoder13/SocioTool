---
import Layout from '../layouts/Layout.astro';

interface Props {
  error: unknown;
}
const { error } = Astro.props;
---

<Layout title="500: Server Error | SocioTool" description="An unexpected error occurred during execution.">
  <main class="w-full max-w-7xl mx-auto flex-grow flex flex-col items-center justify-center text-center px-6 py-20 md:py-32">
    <div class="relative z-10 flex flex-col items-center">
      {/* Icon Graphic */}
      <div class="w-20 h-20 bg-red-50 dark:bg-slate-800 rounded-2xl flex items-center justify-center text-red-600 dark:text-red-400 mb-6 shadow-sm border border-red-100 dark:border-slate-700 transform rotate-3 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      {/* Status Badge */}
      <span class="text-xs sm:text-sm font-mono font-bold px-3 py-1 bg-red-50 dark:bg-slate-800 text-red-600 dark:text-red-400 rounded-full mb-4 transition-colors border border-red-100 dark:border-slate-700">
        500 ERROR
      </span>
      
      {/* Headings & Copy */}
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-3 transition-colors">
        System Failure
      </h1>
      <p class="text-slate-500 dark:text-slate-400 max-w-md leading-relaxed mb-6 transition-colors text-base md:text-lg">
        The underlying application encountered a fatal error while trying to process your request. Our telemetry systems have been notified.
      </p>

      {/* Conditional Error Display (Dev Mode/Logging) */}
      {error && (
        <div class="mb-8 p-4 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg max-w-xl w-full text-left overflow-x-auto text-xs font-mono text-slate-600 dark:text-slate-400 transition-colors shadow-inner">
          <p class="font-bold mb-1 text-slate-800 dark:text-slate-200">Exception Trace:</p>
          <pre><code>{error instanceof Error ? error.message : String(error)}</code></pre>
        </div>
      )}

      {/* Escape Routes */}
      <div class="flex flex-col sm:flex-row items-center gap-4">
        <button 
          onclick="window.location.reload()"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-slate-900 dark:bg-white font-medium text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 transition-all duration-200 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 transform hover:-translate-y-0.5 w-full sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Retry Connection
        </button>
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-blue-600 font-medium text-white hover:bg-blue-700 transition-all duration-200 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 transform hover:-translate-y-0.5 w-full sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Return to Dashboard
        </a>
      </div>
    </div>

    {/* Abstract UI Elements */}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl h-full -z-10 opacity-30 pointer-events-none mix-blend-multiply dark:mix-blend-lighten">
      <div class="absolute top-[20%] left-[15%] w-64 h-64 bg-red-400/20 dark:bg-red-600/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-[20%] right-[15%] w-64 h-64 bg-orange-400/20 dark:bg-orange-600/10 rounded-full blur-3xl"></div>
    </div>
  </main>
</Layout>
