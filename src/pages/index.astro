---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';

const categories = [...new Set(platforms.map((tool: any) => tool.category))];
const groupedTools = categories.reduce((acc: any, cat: any) => {
  acc[cat] = platforms.filter((tool: any) => tool.category === cat);
  return acc;
}, {});

const formatCategory = (str: string) => {
  return str.split('_').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};
---

<Layout title="SocioTool | Free E-commerce & Marketing Calculators" description="A high-performance network of micro-tools for e-commerce sellers and marketers. Calculate Amazon FBA fees, Stripe margins, dropshipping costs, and break-even ROAS instantly.">
  
  {/* Hero Section */}
  <section class="bg-gradient-to-b from-blue-50 to-white pt-16 md:pt-24 pb-12 md:pb-16 px-4 sm:px-6 lg:px-8 border-b border-slate-100 overflow-x-hidden">
    <div class="w-full max-w-4xl mx-auto text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 tracking-tight mb-4 md:mb-6 leading-tight">
        Master Your <span class="text-blue-600">Unit Economics</span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-slate-600 mb-8 md:mb-10 leading-relaxed w-full max-w-2xl mx-auto">
        Stop guessing your profit margins. Explore our suite of {platforms.length} lightning-fast, privacy-first calculators for marketplaces, logistics, and paid media.
      </p>
    </div>
  </section>

  {/* Tools Directory Grid */}
  <section class="py-12 md:py-16 px-4 sm:px-6 lg:px-8 w-full max-w-7xl mx-auto overflow-x-hidden">
    <div class="space-y-12 md:space-y-16">
      {categories.map((category: any) => (
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-6 md:mb-8 pb-2 border-b-2 border-slate-100 flex items-center gap-2 sm:gap-3 capitalize">
            <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center text-sm flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </span>
            <span class="truncate">{formatCategory(category)}</span>
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
            {groupedTools[category].map((tool: any) => (
              <a href={`/tools/${tool.slug}`} class="group bg-white rounded-2xl border border-slate-200 p-5 md:p-6 shadow-sm hover:shadow-xl hover:border-blue-200 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden flex flex-col h-full min-h-[160px]">
                <div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-full blur-xl -mr-10 -mt-10 group-hover:bg-blue-100 transition-colors"></div>
                
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors relative z-10 pr-4 sm:pr-6 leading-tight">{tool.title}</h3>
                <p class="text-xs sm:text-sm text-slate-500 line-clamp-2 relative z-10 leading-relaxed flex-grow">{tool.metaDescription}</p>
                
                <div class="mt-4 md:mt-6 flex items-center text-blue-600 font-medium text-xs sm:text-sm relative z-10">
                  Open Calculator
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:h-4 sm:w-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
