---
import Layout from '../layouts/Layout.astro';
import platforms from '../data/platforms.json';

const categories = [...new Set(platforms.map((tool: any) => tool.category))];
const groupedTools = categories.reduce((acc: any, cat: any) => {
  acc[cat] = platforms.filter((tool: any) => tool.category === cat);
  return acc;
}, {});

const formatCategory = (str: string) => {
  return str.split('_').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
};
---

<Layout title="SocioTool | Free E-commerce & Marketing Calculators" description="A high-performance network of micro-tools for e-commerce sellers and marketers. Calculate Amazon FBA fees, Stripe margins, dropshipping costs, and break-even ROAS instantly.">
  
  {/* Hero Section */}
  <section class="bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-50/40 via-transparent to-transparent pt-16 md:pt-24 pb-12 md:pb-16 px-4 sm:px-6 lg:px-8 border-b border-slate-100 overflow-x-hidden relative">
    <div class="w-full max-w-4xl mx-auto text-center relative z-10">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tight mb-4 md:mb-6 leading-tight transition-colors">
        Master Your <span class="text-blue-600 dark:text-blue-500">Unit Economics</span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-300 mb-8 leading-relaxed w-full max-w-2xl mx-auto transition-colors">
        Stop guessing your profit margins. Explore our suite of {platforms.length} lightning-fast, privacy-first calculators for marketplaces, logistics, and paid media.
      </p>

      {/* Search Bar */}
      <div class="max-w-xl mx-auto relative group">
        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="h-5 w-5 text-slate-400 dark:text-slate-500 group-focus-within:text-blue-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <label htmlFor="search-input" class="sr-only">Search calculators</label>
        <input
          type="search"
          id="search-input"
          name="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search calculators (e.g., Stripe, Etsy)..."
          class="block w-full pl-11 pr-16 py-3.5 border border-slate-200 dark:border-slate-800 rounded-2xl leading-5 bg-white dark:bg-slate-900 shadow-sm placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:border-blue-500 dark:focus-visible:ring-blue-400 dark:focus-visible:border-blue-400 transition-all text-slate-900 dark:text-white sm:text-sm"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
          <kbd class="inline-flex items-center border border-slate-200 dark:border-slate-700 rounded px-2 py-1 text-xs font-sans font-medium text-slate-400 dark:text-slate-500 bg-slate-50 dark:bg-slate-800 transition-colors">
            ⌘ K
          </kbd>
        </div>
      </div>
    </div>
  </section>

  {/* Tools Directory Grid */}
  <section class="py-12 md:py-16 px-4 sm:px-6 lg:px-8 w-full max-w-[90rem] mx-auto overflow-x-hidden" id="tools-directory">
    <div class="space-y-12 md:space-y-16">
      {categories.map((category: any) => (
        <div class="category-section">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-6 md:mb-8 pb-3 border-b border-slate-100 dark:border-slate-800 flex items-center gap-2 sm:gap-3 capitalize transition-colors">
            <span class="bg-blue-50 dark:bg-slate-900 text-blue-600 dark:text-blue-400 rounded-lg p-2 flex items-center justify-center flex-shrink-0 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </span>
            <span class="truncate tracking-tight">{formatCategory(category)}</span>
          </h2>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
            {groupedTools[category].map((tool: any) => (
              <a href={`/tools/${tool.slug}`} data-search-terms={`${tool.title} ${tool.metaDescription} ${formatCategory(tool.category)}`} class="calculator-card group bg-white dark:bg-slate-900 rounded-2xl border border-slate-100 dark:border-slate-800 p-5 md:p-6 shadow-sm hover:shadow-md dark:hover:shadow-lg dark:hover:bg-slate-800/50 hover:-translate-y-0.5 transition-all duration-200 relative overflow-hidden flex flex-col h-full min-h-[160px] focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
                <div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 dark:bg-slate-800 rounded-full blur-xl -mr-10 -mt-10 group-hover:bg-blue-100/50 dark:group-hover:bg-slate-700 transition-colors"></div>
                
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors relative z-10 pr-4 sm:pr-6 leading-tight">{tool.title}</h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 line-clamp-2 relative z-10 leading-relaxed flex-grow transition-colors">{tool.metaDescription}</p>
                
                <div class="mt-4 md:mt-5 flex items-center text-blue-600 dark:text-blue-400 font-medium text-xs sm:text-sm relative z-10 transition-colors">
                  Open Calculator
                  <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="h-3 w-3 sm:h-4 sm:w-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
      <div id="no-results" class="hidden text-center py-12 text-slate-500 dark:text-slate-400 transition-colors">
        <p class="text-lg">No calculators found matching your search.</p>
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const cards = document.querySelectorAll('.calculator-card');
    const categories = document.querySelectorAll('.category-section');
    const noResults = document.getElementById('no-results');

    searchInput?.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      let totalVisible = 0;
      
      categories.forEach(category => {
        let hasVisibleCards = false;
        const categoryCards = category.querySelectorAll('.calculator-card');
        
        categoryCards.forEach(card => {
          const text = card.getAttribute('data-search-terms')?.toLowerCase() || '';
          if (text.includes(query)) {
            (card as HTMLElement).style.display = '';
            hasVisibleCards = true;
            totalVisible++;
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
        
        (category as HTMLElement).style.display = hasVisibleCards ? '' : 'none';
      });

      if (noResults) {
        noResults.style.display = totalVisible === 0 ? 'block' : 'none';
      }
    });

    // Keyboard shortcut ⌘K or Ctrl K
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    });
  </script>
</Layout>
