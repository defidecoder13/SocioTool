---
import Layout from '../../layouts/Layout.astro';
import UniversalCalculator from '../../components/UniversalCalculator.jsx';
import platforms from '../../data/platforms.json';

export async function getStaticPaths() {
  return platforms.map((tool) => {
    return {
      params: { slug: tool.slug },
      props: { tool },
    };
  });
}

const { tool } = Astro.props;

// Find related tools (same category, max 3, excluding current)
const relatedTools = platforms
  .filter((p) => p.category === tool.category && p.slug !== tool.slug)
  .slice(0, 3);

// Rich Snippets Logic
const baseSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.title,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "description": tool.metaDescription,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = tool.faqs && tool.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": tool.faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
} : null;

const schema = faqSchema ? [baseSchema, faqSchema] : baseSchema;
---

<Layout title={`${tool.title} | Free Calculator`} description={tool.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 overflow-x-hidden">
    {/* Top Zone: Title & Breadcrumbs */}
    <div class="mb-8 md:mb-12 text-center">
      <nav class="flex justify-center mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 transition-colors">
          <li><a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Home</a></li>
          <li><span class="mx-1 md:mx-2">/</span></li>
          <li><span class="text-slate-900 dark:text-white font-medium line-clamp-1 transition-colors">{tool.title}</span></li>
        </ol>
      </nav>
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight mb-4 px-2 transition-colors">{tool.title}</h1>
      <p class="text-base md:text-lg lg:text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto px-4 transition-colors">{tool.metaDescription}</p>
    </div>

    {/* Ad Slot 1 - Top Leaderboard */}
    <div class="w-full flex justify-center py-6 md:py-8 mb-8 px-2">
      <div class="w-full max-w-[728px] min-h-[50px] sm:min-h-[90px] bg-slate-100 dark:bg-slate-900 border border-dashed border-slate-300 dark:border-slate-800 rounded flex items-center justify-center text-slate-400 dark:text-slate-600 text-xs sm:text-sm font-medium transition-colors">
        Advertisement Unit Placeholder
      </div>
    </div>

    {/* Middle Zone: React Calculator */}
    <div class="mb-12 md:mb-16">
      <UniversalCalculator client:load calculatorConfig={tool.calculatorConfig} />
    </div>

    {/* Ad Slot 2 - Content Interstitial */}
    <div class="w-full flex justify-center py-6 md:py-8 mb-8 px-2">
      <div class="w-full max-w-[300px] sm:max-w-[728px] min-h-[250px] md:min-h-[280px] bg-slate-100 dark:bg-slate-900 border border-dashed border-slate-300 dark:border-slate-800 rounded flex items-center justify-center text-slate-400 dark:text-slate-600 text-xs sm:text-sm font-medium transition-colors">
        Advertisement Unit Placeholder
      </div>
    </div>

    {/* Bottom Zone: Educational Content */}
    <article class="prose prose-slate dark:prose-invert prose-sm md:prose-base lg:prose-lg max-w-3xl mx-auto bg-white dark:bg-slate-900 p-6 md:p-10 lg:p-12 rounded-3xl shadow-sm border border-slate-100 dark:border-slate-800 mb-12 space-y-6 transition-colors">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-2">{tool.educationalContent.h2_1}</h2>
      <p class="text-slate-700 dark:text-slate-300 leading-relaxed">{tool.educationalContent.p_1}</p>
      
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-2 pt-4">{tool.educationalContent.h2_2}</h2>
      <p class="text-slate-700 dark:text-slate-300 leading-relaxed">{tool.educationalContent.p_2}</p>
    </article>

    {/* FAQ Section */}
    {tool.faqs && tool.faqs.length > 0 && (
      <section class="max-w-3xl mx-auto mt-12 px-4 mb-16">
        <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-6 text-center transition-colors">Frequently Asked Questions</h3>
        <div class="space-y-2">
          {tool.faqs.map((faq: any) => (
            <details class="group">
              <summary class="flex justify-between items-center font-semibold text-slate-800 dark:text-slate-100 cursor-pointer py-4 border-b border-slate-100 dark:border-slate-800 list-none focus:outline-none hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                <span class="pr-6">{faq.q}</span>
                <span class="flex-shrink-0 text-slate-400 group-hover:text-blue-500 transform group-open:rotate-180 transition-all duration-300">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </summary>
              <div class="text-slate-600 dark:text-slate-400 leading-relaxed pt-2 pb-4 transition-all text-sm md:text-base">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* Related Calculators */}
    {relatedTools.length > 0 && (
      <div class="mt-8 pt-12 border-t border-slate-200 dark:border-slate-800 w-full max-w-5xl mx-auto transition-colors">
        <h3 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white mb-6 md:mb-8 text-center transition-colors">Related Calculators</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          {relatedTools.map((relatedTool: any) => (
            <a href={`/tools/${relatedTool.slug}`} class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-5 md:p-6 shadow-sm hover:shadow-xl dark:hover:shadow-2xl dark:hover:bg-slate-800/50 hover:border-blue-200 dark:hover:border-blue-800 hover:-translate-y-1 transition-all duration-300 flex flex-col min-h-[140px]">
              <h4 class="text-lg font-bold text-slate-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-tight">{relatedTool.title}</h4>
              <p class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 leading-relaxed flex-grow transition-colors">{relatedTool.metaDescription}</p>
              <div class="mt-4 flex items-center text-blue-600 dark:text-blue-400 font-medium text-sm transition-colors">
                Open Calculator
                <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="h-4 w-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </main>
</Layout>
